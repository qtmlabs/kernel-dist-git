From 4e61c83df0ccfe1a13a92850900a9b6ee67faf08 Mon Sep 17 00:00:00 2001
From: Myrrh Periwinkle <myrrhperiwinkle@qtmlabs.xyz>
Date: Wed, 26 Aug 2026 20:33:27 +0700
Subject: [PATCH 5/6] tcp: Update snd_tsval_last when sending ACK in
 TCP_NEW_SYN_RECV

When a keepalive packet is received while a socket is in
TCP_NEW_SYN_RECV (e.g. due to TCP_DEFER_ACCEPT) snd_tsval_last won't be
updated to the tsval of the resulting ACK, causing the later ACK from
the remote peer (with a tsecr value set from the tsval of the previous
ACK) to be dropped for having tsecr > snd_tsval_last, stalling the
connection until the TCP_DEFER_ACCEPT timeout.

Fix this by updating snd_tsval_last in the TCP request_sock_ops.send_ack
handler.

Fixes: 3ba075278c11 ("tcp: be less liberal in TSEcr received while in SYN_RECV state")
Signed-off-by: Myrrh Periwinkle <myrrhperiwinkle@qtmlabs.xyz>
---
 net/ipv4/tcp_ipv4.c | 6 +++++-
 net/ipv6/tcp_ipv6.c | 6 +++++-
 2 files changed, 10 insertions(+), 2 deletions(-)

diff --git a/net/ipv4/tcp_ipv4.c b/net/ipv4/tcp_ipv4.c
index 4b59d258c266..646e2cc6b7a9 100644
--- a/net/ipv4/tcp_ipv4.c
+++ b/net/ipv4/tcp_ipv4.c
@@ -1086,6 +1086,7 @@ static void tcp_v4_reqsk_send_ack(const struct sock *sk, struct sk_buff *skb,
 	 */
 	u32 seq = (sk->sk_state == TCP_LISTEN) ? tcp_rsk(req)->snt_isn + 1 :
 					     tcp_sk(sk)->snd_nxt;
+	u32 tsval = tcp_rsk_tsval(tcp_rsk(req));
 
 #ifdef CONFIG_TCP_AO
 	if (static_branch_unlikely(&tcp_ao_needed.key) &&
@@ -1140,11 +1141,14 @@ static void tcp_v4_reqsk_send_ack(const struct sock *sk, struct sk_buff *skb,
 			key.type = TCP_KEY_MD5;
 	}
 
+	if (inet_rsk(req)->tstamp_ok)
+		WRITE_ONCE(tcp_rsk(req)->snt_tsval_last, tsval);
+
 	/* Cleaning ECN bits of TW ACKs of oow data or is paws_reject */
 	tcp_v4_send_ack(sk, skb, seq,
 			tcp_rsk(req)->rcv_nxt,
 			tcp_synack_window(req) >> inet_rsk(req)->rcv_wscale,
-			tcp_rsk_tsval(tcp_rsk(req)),
+			tsval,
 			req->ts_recent,
 			0, &key,
 			inet_rsk(req)->no_srccheck ? IP_REPLY_ARG_NOSRCCHECK : 0,
diff --git a/net/ipv6/tcp_ipv6.c b/net/ipv6/tcp_ipv6.c
index 6223c2ce53e8..b3125bed1d8f 100644
--- a/net/ipv6/tcp_ipv6.c
+++ b/net/ipv6/tcp_ipv6.c
@@ -1199,6 +1199,7 @@ static void tcp_v6_reqsk_send_ack(const struct sock *sk, struct sk_buff *skb,
 				  struct request_sock *req)
 {
 	struct tcp_key key = {};
+	u32 tsval = tcp_rsk_tsval(tcp_rsk(req));
 
 #ifdef CONFIG_TCP_AO
 	if (static_branch_unlikely(&tcp_ao_needed.key) &&
@@ -1254,6 +1255,9 @@ static void tcp_v6_reqsk_send_ack(const struct sock *sk, struct sk_buff *skb,
 #endif
 	}
 
+	if (inet_rsk(req)->tstamp_ok)
+		WRITE_ONCE(tcp_rsk(req)->snt_tsval_last, tsval);
+
 	/* sk->sk_state == TCP_LISTEN -> for regular TCP_SYN_RECV
 	 * sk->sk_state == TCP_SYN_RECV -> for Fast Open.
 	 */
@@ -1261,7 +1265,7 @@ static void tcp_v6_reqsk_send_ack(const struct sock *sk, struct sk_buff *skb,
 			tcp_rsk(req)->snt_isn + 1 : tcp_sk(sk)->snd_nxt,
 			tcp_rsk(req)->rcv_nxt,
 			tcp_synack_window(req) >> inet_rsk(req)->rcv_wscale,
-			tcp_rsk_tsval(tcp_rsk(req)),
+			tsval,
 			req->ts_recent, sk->sk_bound_dev_if,
 			&key, ipv6_get_dsfield(ipv6_hdr(skb)) & ~INET_ECN_MASK,
 			0,
-- 
2.55.0


From c68275c803d6fd672bd80e89cd5b2369a92e4232 Mon Sep 17 00:00:00 2001
From: Myrrh Periwinkle <myrrhperiwinkle@qtmlabs.xyz>
Date: Thu, 27 Aug 2026 07:11:36 +0700
Subject: [PATCH 6/6] mm/compaction: Use folio_expected_ref_count for pinned
 page detection

---
 mm/compaction.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/mm/compaction.c b/mm/compaction.c
index 42eec51c0604..071733f0bbeb 100644
--- a/mm/compaction.c
+++ b/mm/compaction.c
@@ -1094,18 +1094,19 @@ isolate_migratepages_block(struct compact_control *cc, unsigned long low_pfn,
 			goto isolate_fail;
 
 		/*
-		 * Migration will fail if an anonymous page is pinned in memory,
+		 * Migration will fail if a page is pinned in memory,
 		 * so avoid taking lru_lock and isolating it unnecessarily in an
 		 * admittedly racy check.
 		 */
-		mapping = folio_mapping(folio);
-		if (!mapping && (folio_ref_count(folio) - 1) > folio_mapcount(folio))
+		if (folio_ref_count(folio) !=
+		    folio_expected_ref_count(folio) + 1)
 			goto isolate_fail_put;
 
 		/*
 		 * Only allow to migrate anonymous pages in GFP_NOFS context
 		 * because those do not depend on fs locks.
 		 */
+		mapping = folio_mapping(folio);
 		if (!(cc->gfp_mask & __GFP_FS) && mapping)
 			goto isolate_fail_put;
 
-- 
2.55.0

