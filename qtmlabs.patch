From 39207e8b3f277857a2e2f57a93f89d58dd6c961f Mon Sep 17 00:00:00 2001
From: Myrrh Periwinkle <myrrhperiwinkle@qtmlabs.xyz>
Date: Thu, 10 Apr 2025 21:39:04 +0700
Subject: [PATCH 1/3] Bluetooth: btmtk: Firmware loading support for MT7902

---
 drivers/bluetooth/btmtk.c | 2 ++
 drivers/bluetooth/btmtk.h | 1 +
 drivers/bluetooth/btusb.c | 4 ++++
 3 files changed, 7 insertions(+)

diff --git a/drivers/bluetooth/btmtk.c b/drivers/bluetooth/btmtk.c
index a8c520dc09e1..a2713a88d447 100644
--- a/drivers/bluetooth/btmtk.c
+++ b/drivers/bluetooth/btmtk.c
@@ -1325,6 +1325,7 @@ int btmtk_usb_setup(struct hci_dev *hdev)
 		break;
 	case 0x7922:
 	case 0x7925:
+	case 0x7902:
 	case 0x7961:
 		btmtk_fw_get_filename(fw_bin_name, sizeof(fw_bin_name), dev_id,
 				      fw_version, fw_flavor);
@@ -1497,3 +1498,4 @@ MODULE_FIRMWARE(FIRMWARE_MT7668);
 MODULE_FIRMWARE(FIRMWARE_MT7922);
 MODULE_FIRMWARE(FIRMWARE_MT7961);
 MODULE_FIRMWARE(FIRMWARE_MT7925);
+MODULE_FIRMWARE(FIRMWARE_MT7902);
diff --git a/drivers/bluetooth/btmtk.h b/drivers/bluetooth/btmtk.h
index 5df7c3296624..1fc40b2874ed 100644
--- a/drivers/bluetooth/btmtk.h
+++ b/drivers/bluetooth/btmtk.h
@@ -7,6 +7,7 @@
 #define FIRMWARE_MT7922		"mediatek/BT_RAM_CODE_MT7922_1_1_hdr.bin"
 #define FIRMWARE_MT7961		"mediatek/BT_RAM_CODE_MT7961_1_2_hdr.bin"
 #define FIRMWARE_MT7925		"mediatek/mt7925/BT_RAM_CODE_MT7925_1_1_hdr.bin"
+#define FIRMWARE_MT7902		"mediatek/BT_RAM_CODE_MT7902_1_1_hdr.bin"
 
 #define HCI_EV_WMT 0xe4
 #define HCI_WMT_MAX_EVENT_SIZE		64
diff --git a/drivers/bluetooth/btusb.c b/drivers/bluetooth/btusb.c
index 9efdd111baf5..9df4584c3ee5 100644
--- a/drivers/bluetooth/btusb.c
+++ b/drivers/bluetooth/btusb.c
@@ -733,6 +733,10 @@ static const struct usb_device_id quirks_table[] = {
 	{ USB_DEVICE(0x13d3, 0x3630), .driver_info = BTUSB_MEDIATEK |
 						     BTUSB_WIDEBAND_SPEECH },
 
+	/* MediaTek MT7902 Bluetooth devices */
+	{ USB_DEVICE(0x13d3, 0x3579), .driver_info = BTUSB_MEDIATEK |
+		                                     BTUSB_WIDEBAND_SPEECH },
+
 	/* Additional Realtek 8723AE Bluetooth devices */
 	{ USB_DEVICE(0x0930, 0x021d), .driver_info = BTUSB_REALTEK },
 	{ USB_DEVICE(0x13d3, 0x3394), .driver_info = BTUSB_REALTEK },
-- 
2.51.0


From 60d438afee67ac2ac0b37baff01e4f0cc390504f Mon Sep 17 00:00:00 2001
From: Myrrh Periwinkle <myrrhperiwinkle@qtmlabs.xyz>
Date: Mon, 7 Jul 2025 10:43:40 +0700
Subject: [PATCH 2/3] drm: Allow disabling automatic DRM master acquisition
 semantics

---
 drivers/gpu/drm/Kconfig    | 17 +++++++++++++++++
 drivers/gpu/drm/drm_auth.c | 27 ++++++++++++++++++---------
 2 files changed, 35 insertions(+), 9 deletions(-)

diff --git a/drivers/gpu/drm/Kconfig b/drivers/gpu/drm/Kconfig
index f7ea8e895c0c..95d9aa7bdc11 100644
--- a/drivers/gpu/drm/Kconfig
+++ b/drivers/gpu/drm/Kconfig
@@ -33,6 +33,23 @@ endmenu
 
 if DRM
 
+config DRM_AUTO_MASTER
+	bool "Grant master privileges to the first client to open a primary node"
+	depends on DRM
+	default y
+	help
+	  Choose this option to automatically grant master privileges to the
+	  first client to open a primary device node.
+
+	  Say "N" here if your operating system has a privileged system service
+	  (e.g. systemd-logind) that mediates DRM master access between multiple
+	  login sessions.
+
+	  If unsure, say "Y".
+
+	  This can be overridden by the drm.auto_master kernel parameter or by
+	  writing to the /sys/module/drm/parameters/auto_master sysfs entry.
+
 config DRM_MIPI_DBI
 	tristate
 	depends on DRM
diff --git a/drivers/gpu/drm/drm_auth.c b/drivers/gpu/drm/drm_auth.c
index 22aa015df387..7bd65b5604e7 100644
--- a/drivers/gpu/drm/drm_auth.c
+++ b/drivers/gpu/drm/drm_auth.c
@@ -29,6 +29,8 @@
  */
 
 #include <linux/slab.h>
+#include <linux/kconfig.h>
+#include <linux/moduleparam.h>
 
 #include <drm/drm_auth.h>
 #include <drm/drm_drv.h>
@@ -150,17 +152,18 @@ struct drm_master *drm_master_create(struct drm_device *dev)
 	return master;
 }
 
-static void drm_set_master(struct drm_device *dev, struct drm_file *fpriv,
-			   bool new_master)
+static void drm_set_master(struct drm_device *dev, struct drm_file *fpriv)
 {
 	dev->master = drm_master_get(fpriv->master);
 	if (dev->driver->master_set)
-		dev->driver->master_set(dev, fpriv, new_master);
+		dev->driver->master_set(dev, fpriv, !fpriv->was_master);
 
 	fpriv->was_master = true;
+	fpriv->authenticated = true;
 }
 
-static int drm_new_set_master(struct drm_device *dev, struct drm_file *fpriv)
+static int drm_new_master(struct drm_device *dev, struct drm_file *fpriv,
+			  bool set_master)
 {
 	struct drm_master *old_master;
 	struct drm_master *new_master;
@@ -177,9 +180,9 @@ static int drm_new_set_master(struct drm_device *dev, struct drm_file *fpriv)
 	spin_unlock(&fpriv->master_lookup_lock);
 
 	fpriv->is_master = 1;
-	fpriv->authenticated = 1;
 
-	drm_set_master(dev, fpriv, true);
+	if (set_master)
+		drm_set_master(dev, fpriv);
 
 	if (old_master)
 		drm_master_put(&old_master);
@@ -268,7 +271,7 @@ int drm_setmaster_ioctl(struct drm_device *dev, void *data,
 	}
 
 	if (!file_priv->is_master) {
-		ret = drm_new_set_master(dev, file_priv);
+		ret = drm_new_master(dev, file_priv, true);
 		goto out_unlock;
 	}
 
@@ -280,7 +283,7 @@ int drm_setmaster_ioctl(struct drm_device *dev, void *data,
 		goto out_unlock;
 	}
 
-	drm_set_master(dev, file_priv, false);
+	drm_set_master(dev, file_priv);
 out_unlock:
 	mutex_unlock(&dev->master_mutex);
 	return ret;
@@ -329,6 +332,12 @@ int drm_dropmaster_ioctl(struct drm_device *dev, void *data,
 	return ret;
 }
 
+static bool auto_master = IS_ENABLED(CONFIG_DRM_AUTO_MASTER);
+module_param(auto_master, bool, 0644);
+MODULE_PARM_DESC(
+	auto_master,
+	"Grant master privileges to the first client to open a primary node");
+
 int drm_master_open(struct drm_file *file_priv)
 {
 	struct drm_device *dev = file_priv->minor->dev;
@@ -339,7 +348,7 @@ int drm_master_open(struct drm_file *file_priv)
 	 */
 	mutex_lock(&dev->master_mutex);
 	if (!dev->master) {
-		ret = drm_new_set_master(dev, file_priv);
+		ret = drm_new_master(dev, file_priv, auto_master);
 	} else {
 		spin_lock(&file_priv->master_lookup_lock);
 		file_priv->master = drm_master_get(dev->master);
-- 
2.51.0


From 29c304ee84515a03cf49d11169d070e9bb65f0a9 Mon Sep 17 00:00:00 2001
From: "Rafael J. Wysocki" <rafael.j.wysocki@intel.com>
Date: Wed, 10 Sep 2025 11:41:59 +0200
Subject: [PATCH 3/3] PM: hibernate: Restrict GFP mask in
 hibernation_snapshot()

Commit 12ffc3b1513e ("PM: Restrict swap use to later in the suspend
sequence") incorrectly removed a pm_restrict_gfp_mask() call from
hibernation_snapshot(), so memory allocations involving swap are not
prevented from being carried out in this code path any more which may
lead to serious breakage.

The symptoms of such breakage have become visible after adding a
shrink_shmem_memory() call to hibernation_snapshot() in commit
2640e819474f ("PM: hibernate: shrink shmem pages after dev_pm_ops.prepare()")
which caused this problem to be much more likely to manifest itself.

However, since commit 2640e819474f was initially present in the DRM
tree that did not include commit 12ffc3b1513e, the symptoms of this
issue were not visible until merge commit 260f6f4fda93 ("Merge tag
'drm-next-2025-07-30' of https://gitlab.freedesktop.org/drm/kernel")
that exposed it through an entirely reasonable merge conflict
resolution.

Fixes: 12ffc3b1513e ("PM: Restrict swap use to later in the suspend sequence")
Closes: https://bugzilla.kernel.org/show_bug.cgi?id=220555
Reported-by: Todd Brandt <todd.e.brandt@linux.intel.com>
Tested-by: Todd Brandt <todd.e.brandt@linux.intel.com>
Cc: 6.16+ <stable@vger.kernel.org> # 6.16+
Signed-off-by: Rafael J. Wysocki <rafael.j.wysocki@intel.com>
Reviewed-by: Mario Limonciello (AMD) <superm1@kernel.org>
---
 kernel/power/hibernate.c | 1 +
 1 file changed, 1 insertion(+)

diff --git a/kernel/power/hibernate.c b/kernel/power/hibernate.c
index 9216e3b91d3b..c8022a477d3a 100644
--- a/kernel/power/hibernate.c
+++ b/kernel/power/hibernate.c
@@ -423,6 +423,7 @@ int hibernation_snapshot(int platform_mode)
 	}
 
 	console_suspend_all();
+	pm_restrict_gfp_mask();
 
 	error = dpm_suspend(PMSG_FREEZE);
 
-- 
2.51.0

