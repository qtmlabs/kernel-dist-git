From c7e7b6266583472f06790cfec9556ae74649664c Mon Sep 17 00:00:00 2001
From: Myrrh Periwinkle <myrrhperiwinkle@qtmlabs.xyz>
Date: Mon, 23 Mar 2026 20:55:31 +0700
Subject: [PATCH 1/7] drm/i915: Fix tiled panic write when pitch != width * cpp

---
 drivers/gpu/drm/i915/gem/i915_gem_panic.c | 4 ++--
 drivers/gpu/drm/xe/display/xe_panic.c     | 2 +-
 2 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/drivers/gpu/drm/i915/gem/i915_gem_panic.c b/drivers/gpu/drm/i915/gem/i915_gem_panic.c
index 91389d36f101..6b1121779bdd 100644
--- a/drivers/gpu/drm/i915/gem/i915_gem_panic.c
+++ b/drivers/gpu/drm/i915/gem/i915_gem_panic.c
@@ -47,7 +47,7 @@ static void i915_gem_object_panic_map_set_pixel(struct drm_scanout_buffer *sb, u
 						unsigned int y, u32 color)
 {
 	struct intel_panic *panic = sb->private;
-	unsigned int offset = panic->tiling(sb->width, x, y);
+	unsigned int offset = panic->tiling(sb->pitch[0] / sb->format->cpp[0], x, y);
 
 	iosys_map_wr(&sb->map[0], offset, u32, color);
 }
@@ -65,7 +65,7 @@ static void i915_gem_object_panic_page_set_pixel(struct drm_scanout_buffer *sb,
 	unsigned int offset;
 
 	if (panic->tiling)
-		offset = panic->tiling(sb->width, x, y);
+		offset = panic->tiling(sb->pitch[0] / sb->format->cpp[0], x, y);
 	else
 		offset = y * sb->pitch[0] + x * sb->format->cpp[0];
 
diff --git a/drivers/gpu/drm/xe/display/xe_panic.c b/drivers/gpu/drm/xe/display/xe_panic.c
index 12c6fb99015d..2dcd394bdb04 100644
--- a/drivers/gpu/drm/xe/display/xe_panic.c
+++ b/drivers/gpu/drm/xe/display/xe_panic.c
@@ -43,7 +43,7 @@ static void xe_panic_page_set_pixel(struct drm_scanout_buffer *sb, unsigned int
 	unsigned int offset;
 
 	if (panic->tiling)
-		offset = panic->tiling(sb->width, x, y);
+		offset = panic->tiling(sb->pitch[0] / sb->format->cpp[0], x, y);
 	else
 		offset = y * sb->pitch[0] + x * sb->format->cpp[0];
 
-- 
2.56.0


