From 473beddd23c0e0f24316763ff18b7571de08433f Mon Sep 17 00:00:00 2001
From: Myrrh Periwinkle <myrrhperiwinkle@qtmlabs.xyz>
Date: Mon, 7 Jul 2025 10:43:40 +0700
Subject: [PATCH 03/23] drm: Allow disabling automatic DRM master acquisition
 semantics

---
 drivers/gpu/drm/Kconfig    | 17 +++++++++++++++++
 drivers/gpu/drm/drm_auth.c | 27 ++++++++++++++++++---------
 2 files changed, 35 insertions(+), 9 deletions(-)

diff --git a/drivers/gpu/drm/Kconfig b/drivers/gpu/drm/Kconfig
index ed85d0ceee3b..898742bca37f 100644
--- a/drivers/gpu/drm/Kconfig
+++ b/drivers/gpu/drm/Kconfig
@@ -33,6 +33,23 @@ endmenu
 
 if DRM
 
+config DRM_AUTO_MASTER
+	bool "Grant master privileges to the first client to open a primary node"
+	depends on DRM
+	default y
+	help
+	  Choose this option to automatically grant master privileges to the
+	  first client to open a primary device node.
+
+	  Say "N" here if your operating system has a privileged system service
+	  (e.g. systemd-logind) that mediates DRM master access between multiple
+	  login sessions.
+
+	  If unsure, say "Y".
+
+	  This can be overridden by the drm.auto_master kernel parameter or by
+	  writing to the /sys/module/drm/parameters/auto_master sysfs entry.
+
 config DRM_MIPI_DBI
 	tristate
 	depends on DRM
diff --git a/drivers/gpu/drm/drm_auth.c b/drivers/gpu/drm/drm_auth.c
index a2556d16bed6..d2658aa39dce 100644
--- a/drivers/gpu/drm/drm_auth.c
+++ b/drivers/gpu/drm/drm_auth.c
@@ -30,6 +30,8 @@
 
 #include <linux/export.h>
 #include <linux/slab.h>
+#include <linux/kconfig.h>
+#include <linux/moduleparam.h>
 
 #include <drm/drm_auth.h>
 #include <drm/drm_drv.h>
@@ -149,17 +151,18 @@ struct drm_master *drm_master_create(struct drm_device *dev)
 	return master;
 }
 
-static void drm_set_master(struct drm_device *dev, struct drm_file *fpriv,
-			   bool new_master)
+static void drm_set_master(struct drm_device *dev, struct drm_file *fpriv)
 {
 	dev->master = drm_master_get(fpriv->master);
 	if (dev->driver->master_set)
-		dev->driver->master_set(dev, fpriv, new_master);
+		dev->driver->master_set(dev, fpriv, !fpriv->was_master);
 
 	fpriv->was_master = true;
+	fpriv->authenticated = true;
 }
 
-static int drm_new_set_master(struct drm_device *dev, struct drm_file *fpriv)
+static int drm_new_master(struct drm_device *dev, struct drm_file *fpriv,
+			  bool set_master)
 {
 	struct drm_master *old_master;
 	struct drm_master *new_master;
@@ -176,9 +179,9 @@ static int drm_new_set_master(struct drm_device *dev, struct drm_file *fpriv)
 	spin_unlock(&fpriv->master_lookup_lock);
 
 	fpriv->is_master = 1;
-	fpriv->authenticated = 1;
 
-	drm_set_master(dev, fpriv, true);
+	if (set_master)
+		drm_set_master(dev, fpriv);
 
 	if (old_master)
 		drm_master_put(&old_master);
@@ -263,7 +266,7 @@ int drm_setmaster_ioctl(struct drm_device *dev, void *data,
 		return -EINVAL;
 
 	if (!file_priv->is_master)
-		return drm_new_set_master(dev, file_priv);
+		return drm_new_master(dev, file_priv, true);
 
 	if (file_priv->master->lessor != NULL) {
 		drm_dbg_lease(dev,
@@ -272,7 +275,7 @@ int drm_setmaster_ioctl(struct drm_device *dev, void *data,
 		return -EINVAL;
 	}
 
-	drm_set_master(dev, file_priv, false);
+	drm_set_master(dev, file_priv);
 
 	return ret;
 }
@@ -314,6 +317,12 @@ int drm_dropmaster_ioctl(struct drm_device *dev, void *data,
 	return ret;
 }
 
+static bool auto_master = IS_ENABLED(CONFIG_DRM_AUTO_MASTER);
+module_param(auto_master, bool, 0644);
+MODULE_PARM_DESC(
+	auto_master,
+	"Grant master privileges to the first client to open a primary node");
+
 int drm_master_open(struct drm_file *file_priv)
 {
 	struct drm_device *dev = file_priv->minor->dev;
@@ -324,7 +333,7 @@ int drm_master_open(struct drm_file *file_priv)
 	 */
 	guard(mutex)(&dev->master_mutex);
 	if (!dev->master) {
-		ret = drm_new_set_master(dev, file_priv);
+		ret = drm_new_master(dev, file_priv, auto_master);
 	} else {
 		spin_lock(&file_priv->master_lookup_lock);
 		file_priv->master = drm_master_get(dev->master);
-- 
