From 3255ac75e4f05e6194b4a3112d0c2f564dbd0e64 Mon Sep 17 00:00:00 2001
From: Myrrh Periwinkle <myrrhperiwinkle@qtmlabs.xyz>
Date: Mon, 23 Mar 2026 20:55:31 +0700
Subject: [PATCH 01/23] drm/i915: Fix tiled panic write for cases where pitch
 != width * cpp

---
 drivers/gpu/drm/i915/gem/i915_gem_pages.c | 4 ++--
 drivers/gpu/drm/xe/display/xe_panic.c     | 2 +-
 2 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/drivers/gpu/drm/i915/gem/i915_gem_pages.c b/drivers/gpu/drm/i915/gem/i915_gem_pages.c
index c2f8e5f95696..a8e5896f8ef2 100644
--- a/drivers/gpu/drm/i915/gem/i915_gem_pages.c
+++ b/drivers/gpu/drm/i915/gem/i915_gem_pages.c
@@ -396,7 +396,7 @@ static void i915_gem_object_panic_map_set_pixel(struct drm_scanout_buffer *sb, u
 						unsigned int y, u32 color)
 {
 	struct intel_framebuffer *fb = (struct intel_framebuffer *)sb->private;
-	unsigned int offset = fb->panic_tiling(sb->width, x, y);
+	unsigned int offset = fb->panic_tiling(sb->pitch[0] / sb->format->cpp[0], x, y);
 
 	iosys_map_wr(&sb->map[0], offset, u32, color);
 }
@@ -415,7 +415,7 @@ static void i915_gem_object_panic_page_set_pixel(struct drm_scanout_buffer *sb,
 	struct intel_panic *panic = fb->panic;
 
 	if (fb->panic_tiling)
-		offset = fb->panic_tiling(sb->width, x, y);
+		offset = fb->panic_tiling(sb->pitch[0] / sb->format->cpp[0], x, y);
 	else
 		offset = y * sb->pitch[0] + x * sb->format->cpp[0];
 
diff --git a/drivers/gpu/drm/xe/display/xe_panic.c b/drivers/gpu/drm/xe/display/xe_panic.c
index df663286092a..79fb4cbd639d 100644
--- a/drivers/gpu/drm/xe/display/xe_panic.c
+++ b/drivers/gpu/drm/xe/display/xe_panic.c
@@ -42,7 +42,7 @@ static void xe_panic_page_set_pixel(struct drm_scanout_buffer *sb, unsigned int
 	unsigned int offset;
 
 	if (fb->panic_tiling)
-		offset = fb->panic_tiling(sb->width, x, y);
+		offset = fb->panic_tiling(sb->pitch[0] / sb->format->cpp[0], x, y);
 	else
 		offset = y * sb->pitch[0] + x * sb->format->cpp[0];
 
-- 
2.53.0


From 2af2eb2236f61e9e9afbcc23b270fc2472185c07 Mon Sep 17 00:00:00 2001
From: Myrrh Periwinkle <myrrhperiwinkle@qtmlabs.xyz>
Date: Mon, 23 Mar 2026 21:40:30 +0700
Subject: [PATCH 02/23] drm/i915: Always disable compression when disabling
 tiling

---
 drivers/gpu/drm/i915/display/skl_universal_plane.c | 6 ++----
 1 file changed, 2 insertions(+), 4 deletions(-)

diff --git a/drivers/gpu/drm/i915/display/skl_universal_plane.c b/drivers/gpu/drm/i915/display/skl_universal_plane.c
index ed14b9ea2ad2..5f4b14e2eb50 100644
--- a/drivers/gpu/drm/i915/display/skl_universal_plane.c
+++ b/drivers/gpu/drm/i915/display/skl_universal_plane.c
@@ -2830,11 +2830,9 @@ static void skl_disable_tiling(struct intel_plane *plane)
 	u32 plane_ctl;
 
 	plane_ctl = intel_de_read(display, PLANE_CTL(plane->pipe, plane->id));
+	plane_ctl &= ~PLANE_CTL_RENDER_DECOMPRESSION_ENABLE;
 
-	if (intel_fb_uses_dpt(fb)) {
-		/* if DPT is enabled, keep tiling, but disable compression */
-		plane_ctl &= ~PLANE_CTL_RENDER_DECOMPRESSION_ENABLE;
-	} else {
+	if (!intel_fb_uses_dpt(fb)) {
 		/* if DPT is not supported, disable tiling, and update stride */
 		u32 stride = state->view.color_plane[0].scanout_stride / 64;
 
